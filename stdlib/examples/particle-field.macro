;; kind: render
;; entry: render-frame
;; semantics: draw a whole FIELD of particles — one soft circle per particle — by looping over the position arrays, varying color per particle so the field is many-hued
;; reads: px, py, count
;; tags: draw-at-position, particle-field, loop, iterate
(cell render-frame
  (for $i (get count)
    (draw (circle (atidx px $i) (atidx py $i) (i32.const 3)
      (i32.or
        (i32.shl (i32.and (i32.mul (local.get $i) (i32.const 20)) (i32.const 255)) (i32.const 24))
        (i32.const 0x40E0FF))))))
