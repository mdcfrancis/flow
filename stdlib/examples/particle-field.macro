;; kind: render
;; entry: render-frame
;; semantics: draw a whole FIELD of particles — one soft circle per particle — by looping over the collection columns, reading each particle's position with (atidxi) for a pixel coordinate, and varying color per particle so the field is many-hued
;; reads: particle_x, particle_y, particle_count
;; tags: draw-at-position, particle-field, collection-loop, loop, iterate, nebula
(cell render-frame
  (for $i (get particle_count)
    (draw (circle (atidxi particle_x $i) (atidxi particle_y $i) (i32.const 3)
      (i32.or
        (i32.shl (i32.and (i32.mul (local.get $i) (i32.const 20)) (i32.const 255)) (i32.const 24))
        (i32.const 0x40E0FF))))))
